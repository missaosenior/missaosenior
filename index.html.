 const SHEETS_WEB_APP_URL = "https://script.google.com/macros/s/AKfycby-Ogge_tImusVWm3Hc7GO0QzEboWDiGhuGwmbfREwj-54Gl-dcF5_59cyL0pFCpgqD/exec";
 let surveySent = false;
 const newId=()=> (globalThis.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2)}`);
 let surveyId=newId(), contactId=newId();
 const queueKey='missaoSeniorFilaV3';
 const oldKey='missaoSeniorPendingV2';
 function lerFila(){try{const x=JSON.parse(localStorage.getItem(queueKey)||'[]');return Array.isArray(x)?x:[]}catch(e){return []}}
 function gravarFila(fila){localStorage.setItem(queueKey,JSON.stringify(fila));}
 // Preserva também os envios guardados pelas versões anteriores do site.
 try{
   const antigo=JSON.parse(localStorage.getItem(oldKey)||'null');
   if(antigo&&antigo.id){const fila=lerFila();if(!fila.some(x=>x.id===antigo.id)){fila.unshift(antigo);gravarFila(fila)}localStorage.removeItem(oldKey)}
 }catch(e){}
 function colocarNaFila(payload){
   const fila=lerFila();
   if(!fila.some(x=>x.id===payload.id)){fila.push(payload);gravarFila(fila)}
 }
 // Verificação independente da gravação, através do doGet já existente no Apps Script.
 // Não considera um envio concluído sem confirmação positiva do Google Sheets.
 function verificarGuardado(payload){
   return new Promise(resolve=>{
     const nome='msCallback_'+Math.random().toString(36).slice(2,14);
     const script=document.createElement('script');
     let terminado=false;
     let limite;
     const terminar=(guardado)=>{
       if(terminado)return;
       terminado=true;clearTimeout(limite);delete window[nome];script.remove();resolve(guardado===true);
     };
     const id=payload.tipo==='contacto'?payload.inqueritoId:payload.id;
     window[nome]=(resposta)=>terminar(Boolean(resposta&&resposta.id===id&&resposta.guardado===true));
     script.onerror=()=>terminar(false);
     limite=setTimeout(()=>terminar(false),5000);
     const parametros=new URLSearchParams({
       action:payload.tipo==='contacto'?'contactStatus':'status',id,callback:nome,_:String(Date.now())
     });
     if(payload.tipo==='contacto'){
       if(payload.email)parametros.set('email',payload.email);
       if(payload.whatsapp)parametros.set('whatsapp',payload.whatsapp);
     }
     script.src=SHEETS_WEB_APP_URL+'?'+parametros.toString();
     document.head.appendChild(script);
   });
 }
 // Envio em iframe para aceitar a resposta do Apps Script sem CORS.
 function enviarDados(payload){
   return new Promise((resolve,reject)=>{
     const token=newId();
     const iframe=document.createElement('iframe');
     iframe.name='ms_'+token.replace(/[^a-zA-Z0-9]/g,'');
     iframe.style.display='none';iframe.title='Transmissão do inquérito';
     const form=document.createElement('form');
     form.method='POST';form.action=SHEETS_WEB_APP_URL;form.target=iframe.name;
     form.style.display='none';
     [['payload',JSON.stringify(payload)],['token',token],['callback','iframe']].forEach(([name,value])=>{
       const field=document.createElement('input');field.type='hidden';field.name=name;field.value=value;form.append(field);
     });
     let terminou=false;
     const limpar=()=>{window.removeEventListener('message',receber);clearTimeout(limite);if(typeof intervalos!=='undefined')intervalos.forEach(clearTimeout);form.remove();iframe.remove()};
     function receber(ev){
       const d=ev.data;
       if(!d||d.tipo!=='missao-senior-resposta'||d.token!==token||!([payload.id,payload.inqueritoId].filter(Boolean).includes(d.id)))return;
       if(!/^https:\/\/(?:[a-z0-9-]+\.)*(?:googleusercontent\.com|google\.com)$/.test(ev.origin))return;
       if(terminou)return;
       terminou=true;limpar();
       if(d.sucesso===true)resolve(d);
       else reject(new Error(d.mensagem||'O servidor não confirmou a gravação.'));
     }
     // Confirma também os contactos diretamente na linha do inquérito,
     // caso o navegador móvel bloqueie o postMessage do Google.
     let verificacaoEmCurso=false;
     const intervalos=[];
     const verificar=async()=>{
       if(terminou||verificacaoEmCurso)return;
       verificacaoEmCurso=true;
       try{
         if(await verificarGuardado(payload)){
           if(!terminou){terminou=true;limpar();resolve({sucesso:true,id:payload.id,confirmacao:'folha'});}
         }
       }finally{verificacaoEmCurso=false}
     };
     [1200,3200,6000,10000,15000].forEach(ms=>intervalos.push(setTimeout(verificar,ms)));
     const limite=setTimeout(()=>{if(terminou)return;terminou=true;limpar();reject(new Error('Sem confirmação do servidor.'))},20000);
     window.addEventListener('message',receber);
     document.body.append(iframe,form);
     try{form.submit()}catch(e){if(!terminou){terminou=true;limpar();reject(e)}}
   });
 }
 let aProcessar=false;
 async function processarFila(){
   if(aProcessar||!navigator.onLine)return;
   aProcessar=true;
   try{
     // Respeita a ordem: primeiro inquérito, depois contacto associado.
     while(lerFila().length){
       const item=lerFila()[0];
       try{await enviarDados(item)}catch(e){console.warn('Missão Sénior: envio pendente',e.message);break}
       const fila=lerFila();
       const pos=fila.findIndex(x=>x.id===item.id);
       if(pos>=0){fila.splice(pos,1);gravarFila(fila)}
     }
   }finally{aProcessar=false}
 }
 async function enviarComSeguranca(payload){
   // A gravação local é obrigatória antes de deixar o visitante avançar.
   colocarNaFila(payload);
   // Confirma a gravação efetiva antes de apresentar o ecrã de sucesso.
   // Um envio anterior nunca impede o atual; o servidor elimina duplicados pelo ID.
   try {
     const confirmacao = await enviarDados(payload);
     const fila = lerFila();
     const pos = fila.findIndex(x => x.id === payload.id);
     if (pos >= 0) { fila.splice(pos, 1); gravarFila(fila); }
     processarFila();
     return confirmacao;
   } catch (erro) {
     console.error('Missão Sénior — envio não confirmado:', erro);
     throw new Error('Não foi possível confirmar o envio. Os dados ficaram guardados neste navegador para nova tentativa.');
   }
 }
