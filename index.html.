 let audience="resident",index=0,answers={resident:{},abroad:{},pro:{}};function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
 function render(){const d=surveys[audience],q=d.qs[index],saved=answers[audience][index];$('surveyName').textContent=d.name;$('counter').textContent=`Pergunta ${index+1} de ${d.qs.length}`;$('progress').style.width=`${(index+1)/d.qs.length*100}%`;$('back').disabled=index===0;$('next').textContent=index===d.qs.length-1?'Concluir ✓':'Continuar →';$('questionArea').classList.remove('hidden');$('nav').classList.remove('hidden');$('result').classList.remove('show');$('sendStep').classList.remove('hidden');$('thanksStep').classList.add('hidden');$('endStep').classList.add('hidden');let h=`<div class="question-kicker">Pergunta ${String(index+1).padStart(2,'0')}</div><h3 class="question-title">${q.q}</h3>${q.help?`<p class="question-help">${q.help}</p>`:''}`;if(q.type==='text'){h+=`<input class="other" id="textAnswer" type="text" maxlength="120" placeholder="${esc(q.placeholder||'Escreva a sua resposta…')}" value="${esc(saved||'')}">`}else{h+='<div class="options">'+q.opts.map((o,i)=>{const checked=Array.isArray(saved)?saved.includes(o):saved===o;const t=q.type==='check'?'checkbox':'radio';return `<div class="option"><input id="opt${i}" type="${t}" name="answer" value="${esc(o)}" ${checked?'checked':''}><label for="opt${i}">${o}</label></div>`}).join('')+'</div>';if(q.max)h+=`<p class="question-help" style="margin:10px 0 0">Selecione no máximo ${q.max} opções.</p>`}$('questionArea').innerHTML=h;const area=$('questionArea');area.classList.remove('question-enter');void area.offsetWidth;area.classList.add('question-enter');if(q.type==='check'){const ins=[...document.querySelectorAll('input[name="answer"]')];ins.forEach(inp=>inp.addEventListener('change',()=>{if(q.max&&ins.filter(x=>x.checked).length>q.max){inp.checked=false;alert(`Pode selecionar no máximo ${q.max} opções.`)}}))}}
