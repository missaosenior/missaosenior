     estado.textContent='Falta preencher uma resposta. Volte às perguntas para a completar.';return;
   }
   botao.disabled=true;estado.textContent='A guardar…';
   try{
     await enviarComSeguranca({id:surveyId,perfil:audience,respostas});
     surveySent=true;
     $('sendStep').classList.add('hidden');$('thanksStep').classList.remove('hidden');scrollToQuestion();
   }catch(e){estado.textContent=e.message || 'Envio não confirmado. Tente novamente.';}
   finally{botao.disabled=false}
 });
 $('sendContact').addEventListener('click',async()=>{
   const email=$('emailNews').value.trim(),whatsapp=$('whatsappNews').value.trim();
   const estado=$('contactStatus'),botao=$('sendContact');
   if(!email&&!whatsapp){estado.textContent='Indique o seu email ou WhatsApp.';return;}
   if(email&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){estado.textContent='Introduza um email válido.';return;}
   if(whatsapp&&!/^\+?[0-9\s()\-]{8,20}$/.test(whatsapp)){estado.textContent='Introduza um número de WhatsApp válido.';return;}
   if(!$('consentNews').checked){estado.textContent='Assinale a autorização para receber novidades.';return;}
   // Fecha o teclado móvel e confirma os valores atuais antes do envio.
   if(document.activeElement && typeof document.activeElement.blur==='function')document.activeElement.blur();
   botao.disabled=true;estado.textContent='A guardar…';
   try{
     await enviarComSeguranca({tipo:'contacto',id:contactId,perfil:audience,inqueritoId:surveyId,email,whatsapp,consentimento:true});
     $('thanksStep').classList.add('hidden');$('endStep').classList.remove('hidden');scrollToQuestion();
   }catch(e){estado.textContent=e.message || 'Envio não confirmado. Tente novamente.';}
   finally{botao.disabled=false}
 });
